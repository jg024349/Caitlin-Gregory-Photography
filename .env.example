# Required after creating the Instagram API app and authorizing the account.
INSTAGRAM_ACCESS_TOKEN=replace_with_your_long_lived_token

# Required for contact/about forms. Create a Formspree form and paste the full endpoint here.
FORMSPREE_ENDPOINT=https://formspree.io/f/replace_with_your_form_id
CONTACT_FORM_SUBJECT=New Caitlin Gregory Photography inquiry

# Optional server settings.
HOST=127.0.0.1
PORT=3000
INSTAGRAM_CACHE_MINUTES=15
